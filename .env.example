# Sales Tracking System - FRONTEND (Next.js / Vercel)
# Copy to .env for local development. Backend variables belong in backend/.env.
# Never commit real .env files. Never put secrets in NEXT_PUBLIC_* variables.
BACKEND_ORIGIN=http://127.0.0.1:8082

# Vercel: set BACKEND_ORIGIN under Project Settings > Environment Variables
# to the deployed App Runner HTTPS origin, then build/redeploy the frontend.
# Replace the local value above; do not append duplicate assignments.
# BACKEND_ORIGIN=https://YOUR_SERVICE_ID.ap-south-1.awsapprunner.com
# Origin only: no /api suffix, path, query string or credentials.
# Database, Gmail, JWT, OTP and AWS credentials belong on the backend only.
