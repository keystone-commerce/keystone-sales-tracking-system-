RELEASE_SCOPE=pre-sourcing
PORT=8082
FRONTEND_ORIGIN=http://localhost:3210
# Local persistent PostgreSQL engine; never allowed in production.
DEV_EMBEDDED_DB=true
DEV_SEED=true
JWT_SECRET=local-development-only-replace-before-deploy-2026
# Production: disable DEV flags; use dedicated RDS database and least-privilege role.
# DATABASE_URL=postgresql://sales_ops_app:password@RDS_ENDPOINT:5432/sales_ops
# DATABASE_CA_FILE=/app/certs/rds-ca.pem
# SOURCING_PORTAL_URL=https://your-existing-sourcing-portal.example

# Production document uploads: private S3, using the App Runner instance role.
# DOCUMENT_STORAGE=s3
# AWS_REGION=ap-south-1
# S3_DOCUMENT_BUCKET=your-private-sales-ops-documents
# Local default remains database; no AWS credentials required for manual testing.

# Email OTP login (same Gmail OAuth settings as the admin backend).
AUTH_MODE=otp
OTP_HMAC_SECRET=replace-with-an-independent-random-secret-at-least-32-bytes
# Local testing only. Disable both options for real email and all deployments.
OTP_LOG_ONLY=true
OTP_DEV_FIXED_CODE=000000
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=Keystone Sales Ops
