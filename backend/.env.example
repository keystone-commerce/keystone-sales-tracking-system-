# Sales Tracking System - BACKEND (Express / AWS App Runner)
# Local: copy to backend/.env and fill the secrets and Gmail settings.
# The dev launcher reads backend/.env separately from the frontend .env.
# Production: configure these values on App Runner, not Vercel.
# Use Secrets Manager or SSM SecureString references for secret values.
# Replace local values for production; do not append duplicate keys.
# Never commit real .env files, passwords, tokens or database URLs.

# --- Application: local defaults ---
NODE_ENV=development
PORT=8082
RELEASE_SCOPE=manual-sourcing
FRONTEND_ORIGIN=http://localhost:3210

# --- Local database ---
DEV_EMBEDDED_DB=true
DEV_SEED=true
EMBEDDED_PATH=.local-data
# Production uses a separate sales_tracking database in internal-tool-postgres.
# The production database and dedicated database users are still pending.
# Use the Sales Tracking runtime login, NOT team_portal_app or the shared admin.
# URL-encode special characters in the password.
# DATABASE_URL comes from the AWS secret for the sales_tracking database.
# DATABASE_CA_FILE=/app/certs/rds-ca.pem

# --- Secrets: generate two DIFFERENT random values ---
# Run this twice locally, then paste each result into its own setting:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET needs at least 32 characters; OTP_HMAC_SECRET at least 32 bytes.
# Replace both placeholders before starting the backend.
JWT_SECRET=replace-with-a-generated-session-secret
OTP_HMAC_SECRET=replace-with-a-different-generated-otp-secret

# --- Real email OTP sign-in: backend only ---
AUTH_MODE=otp
OTP_LOG_ONLY=false
OTP_DEV_FIXED_CODE=
# Gmail OAuth settings for the authorised sending mailbox.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=Keystone Sales Tracking System
# Only active users already added in Sales Tracking can receive OTP emails.
# Optional OFFLINE LOCAL TEST: set OTP_LOG_ONLY=true and optionally
# OTP_DEV_FIXED_CODE=000000. Requires DEV_EMBEDDED_DB=true.
# Never enable log-only or fixed-code mode in production.

# --- Attachments ---
# Local: database bytes; no AWS login needed.
# Production: S3 bytes with document metadata in PostgreSQL.
DOCUMENT_STORAGE=database
AWS_REGION=ap-south-1
S3_DOCUMENT_BUCKET=keystone-sales-tracking-docs-415407325762-ap-south-1
# This private bucket exists with encryption and versioning enabled.
# The App Runner instance role still needs the dedicated S3 object policy.
# Use that role, not personal AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY values.

# --- PRODUCTION OVERRIDES: replace the local values above ---
# NODE_ENV=production
# PORT=8080
# FRONTEND_ORIGIN=https://YOUR_FRONTEND.vercel.app
# DEV_EMBEDDED_DB=false
# DEV_SEED=false
# DOCUMENT_STORAGE=s3
# Also set DATABASE_URL and DATABASE_CA_FILE above, generate both secrets,
# and fill all Gmail settings. Keep AUTH_MODE=otp, OTP_LOG_ONLY=false,
# OTP_DEV_FIXED_CODE empty and RELEASE_SCOPE=manual-sourcing.
# FRONTEND_ORIGIN must be the exact HTTPS frontend origin, without a path
# or trailing slash. App Runner's configured container port must match PORT.
# DATABASE_CA_FILE is the RDS CA already included in the backend Docker image.

# --- First admin: ONE-TIME BOOTSTRAP JOB ONLY, not the API service ---
# BOOTSTRAP_EMAIL=yashraj@keystonecommerce.in
# BOOTSTRAP_NAME=Yashraj
# BOOTSTRAP_ROLE=admin
# Run the prepared bootstrap-admin-once job after migrations.
# Its DATABASE_URL uses a protected bootstrap database identity, not the
# runtime login. No BOOTSTRAP_PASSWORD is needed for email OTP sign-in.
# Add later users through Admin access. See docs/BOOTSTRAP-ADMIN.md.

# --- Optional future sourcing integration (not connected in V1) ---
# SOURCING_PORTAL_URL=https://YOUR_EXISTING_SOURCING_PORTAL
